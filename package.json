{
  "name": "weather",
  "version": "1.0.0",
  "description": "Weather: a free worldwide forecast for planning ahead, from MET Norway",
  "private": true,
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && wrangler dev --port 8787 --var FRAME_ANCESTORS:\"'self' http://localhost:4000\"",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src worker --ext .ts,.tsx --max-warnings=0",
    "test": "jest",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test start http://localhost:8787 cypress:run"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.5.2",
    "cypress": "15.12.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "start-server-and-test": "2.0.12",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3",
    "vite": "6.3.5",
    "wrangler": "4.86.0"
  }
}
